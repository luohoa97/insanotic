/* The main menu. Sizes are in dp: 720 dp is the height of the window on a
   monitor, and about 450 dp on a touch screen (see rml_scale), so the same
   numbers give bigger things on phones. */

body {
	width: 100%;
	height: 100%;
	font-size: 16dp;
}

#logo {
	position: absolute;
	left: 50%;
	top: 3%;
	width: 36%;
	margin-left: -18%;
}

#stage {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

/* the three big buttons share a row across the middle of the screen */
#big {
	position: absolute;
	left: 8%;
	right: 8%;
	top: 44%;
	height: 20%;
	display: flex;
	flex-direction: row;
}

.card {
	position: relative;
	flex: 1 1 0;
	height: 100%;
	margin-right: 2%;
	border: 1dp #ffffff40;
	background-color: #0d1424;
	cursor: pointer;
	tab-index: auto;
	nav: auto; /* arrow keys move between the buttons */
	animation: rise 0.45s cubic-out;
}
.card:last-child {
	margin-right: 0;
}
#singleplayer { decorator: image(/maps/implosion.jpg cover center center); }
#multiplayer { decorator: image(/maps/stormkeep.jpg cover center center); }
#settings { decorator: image(/maps/solarium.jpg cover center center); }

.card {
	image-color: #808080;
}

.card:hover, .card:active, .card:focus-visible {
	border-color: #4da6ff;
}

/* darker towards the bottom, where the text is */
.shade {
	position: absolute;
	left: 0;
	right: 0;
	top: 40%;
	bottom: 0;
	decorator: vertical-gradient(#00000000 #000000b3);
}

/* light that comes on under a pointer or finger */
.glow {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: #4da6ff00;
	transition: background-color 0.12s;
}
.card:hover .glow, .chip:hover .glow, .card:focus-visible .glow, .chip:focus-visible .glow {
	background-color: #4da6ff33;
}
.card:active .glow, .chip:active .glow {
	background-color: #4da6ff66;
}

.text {
	position: absolute;
	left: 12dp;
	right: 12dp;
	bottom: 10dp;
}
.title {
	font-size: 29dp;
	font-weight: bold;
	white-space: nowrap;
}
.sub {
	font-size: 12dp;
	color: #ccd9e6;
	margin-bottom: 4dp;
}

/* Credits and Quit, centered below */
#small {
	position: absolute;
	left: 0;
	right: 0;
	top: 69%;
	height: 7%;
	text-align: center;
}
.chip {
	display: inline-block;
	position: relative;
	width: 17%;
	height: 100%;
	margin: 0 0.8%;
	border: 1dp #ffffff40;
	background-color: #0d1424cc;
	cursor: pointer;
	tab-index: auto;
	nav: auto;
}
.chip:hover, .chip:active, .chip:focus-visible {
	border-color: #4da6ff;
}
.label {
	position: absolute;
	left: 0;
	right: 0;
	top: 50%;
	margin-top: -11dp;
	font-size: 20dp;
	text-align: center;
}

#version {
	position: absolute;
	right: 10dp;
	bottom: 8dp;
	font-size: 14dp;
	color: #ffffff73;
}

@keyframes rise {
	from { top: 24dp; }
	to { top: 0dp; }
}

/* Phones held sideways: the window is only about 450 dp high (see
   rml_scale), so the same numbers give bigger things. The picture buttons
   grow to fill the space, and Credits and Quit become wide bars. */
@media (max-height: 500dp) {
	#logo {
		top: 2%;
		width: 28%;
		margin-left: -14%;
	}
	#big {
		top: 24%;
		height: 46%;
		left: 5%;
		right: 5%;
	}
	.title {
		font-size: 26dp;
	}
	.sub {
		font-size: 13dp;
	}
	#small {
		top: 74%;
		height: 14%;
	}
	.chip {
		width: 30%;
		min-height: 56dp;
	}
	.label {
		font-size: 22dp;
	}
	#version {
		font-size: 12dp;
	}
}

/* Phones held upright (and any window taller than wide): the three picture
   buttons are stacked, each far taller than a finger needs. */
@media (orientation: portrait) {
	#logo {
		top: 2%;
		width: 64%;
		margin-left: -32%;
	}
	#big {
		top: 15%;
		height: 54%;
		left: 5%;
		right: 5%;
		flex-direction: column;
	}
	.card {
		margin-right: 0;
		margin-bottom: 3%;
	}
	.card:last-child {
		margin-bottom: 0;
	}
	#small {
		top: 72%;
		height: 12%;
	}
	.chip {
		width: 29%;
		margin: 0 1%;
		min-height: 56dp;
	}
	.label {
		font-size: 16dp;
	}
}
