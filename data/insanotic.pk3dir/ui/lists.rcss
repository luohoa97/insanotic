/* Pages that are mostly a long list: the server browser and the campaign.
   The dialog fills the window (so the list gets all the room there is), and
   the list in it scrolls. Used together with components.rcss. */

#content {
	display: flex;
	flex-direction: column;
	left: 50%;
	width: 900dp;
	margin-left: -450dp;
	top: 3%;
	bottom: 3%;
	margin-top: 0;
}
#content .dialog-bar {
	flex: none;
}
#content .dialog-body {
	flex: 1 1 0;
	min-height: 0;
	display: flex;
	flex-direction: column;
	padding: 12dp 16dp 4dp 16dp;
}
#content .dialog-buttons {
	flex: none;
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	padding-bottom: 14dp;
}
#content .dialog-buttons > .grow {
	flex: 1 1 0;
	min-width: 0;
	margin-right: 10dp;
}
#content .dialog-buttons .button {
	flex: none;
}
.dialog-hint {
	position: absolute;
	right: 70dp;
	top: 18dp;
	font-size: 13dp;
	color: #a1a1aa;
}
#content .list {
	flex: 1 1 0;
	min-height: 0;
}
.bar-row {
	flex: none;
	display: flex;
	flex-direction: row;
	margin-bottom: 8dp;
}
.bar-row > * {
	flex: none;
}
.label {
	flex: none;
	padding: 13dp 10dp 0 0;
	font-size: 15dp;
	color: #a1a1aa;
}
.bar-row > .grow {
	flex: 1 1 0;
	min-width: 0;
	margin-right: 10dp;
}
.bar-row label.check {
	min-height: 40dp;
	padding: 10dp 0 0 38dp;
	margin-right: 14dp;
	white-space: nowrap;
}
.bar-row label.check input {
	top: 7dp;
}

/* ---- server list --------------------------------------------------- */

.srv, .list .item.srv {
	display: block;
	padding-left: 6dp;
	padding-right: 6dp;
	min-height: 24dp;
}
.srv-head, .list .srv-head {
	display: flex;
	flex-direction: row;
}
.srv .cells {
	position: relative;
	display: flex;
	flex-direction: row;
}
/* The row shows the map's picture, heavily darkened: a shade that is dark on
   the left (where the text is) and lighter on the right lies over it, and
   the selected row is brighter. A map the client has no picture of (a custom
   map it never downloaded) gets a plain dark row, a little bluer than the
   list, and its name stays in the Map column. */
.srv {
	position: relative;
	background-color: #0c0c0f;
}
.srv .shade {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	decorator: horizontal-gradient(#000000c8 #00000066);
}
.srv.selected .shade {
	decorator: horizontal-gradient(#00000080 #00000008);
}
.srv.nopic .shade {
	decorator: none;
}
/* rows the list keeps but does not show (the engine never shortens the
   list, see ServersRebuild in ui_rml_models.cpp) */
.list .item.srv.gone {
	display: none;
}
.srv.nopic .c-map {
	color: #71717a;
}
.srv.nopic.selected {
	background-color: #27272a;
}
.srv-head {
	background-color: transparent;
}

/* a cell clips its text to its own width: the margin is outside what
   overflow hides, so a long name stops short of the next column */
.srv .cells > div {
	flex: none;
	overflow: hidden;
	white-space: nowrap;
	margin-right: 10dp;
}
.srv .cells .c-ping { width: 56dp; }
.srv .cells .c-name { flex: 1 1 0; min-width: 0; }
.srv .cells .c-map { width: 150dp; }
.srv .cells .c-type { width: 70dp; }
.srv .cells .c-players { width: 70dp; text-align: right; }
.srv-head {
	flex: none;
	margin-bottom: 4dp;
}
.srv-head > div {
	flex: none;
	overflow: hidden;
	white-space: nowrap;
	cursor: pointer;
	tab-index: auto;
	color: #4da6ff;
	font-size: 14dp;
	padding: 10dp 0 8dp 0;
	margin-right: 10dp;
	min-height: 24dp;
}
.srv-head > div:hover {
	color: #ffffff;
}
.srv-head .sorted {
	color: #ffffff;
}
.srv-head .c-ping { width: 56dp; }
.srv-head .c-name { flex: 1 1 0; min-width: 0; }
.srv-head .c-map { width: 150dp; }
.srv-head .c-type { width: 70dp; }
.srv-head .c-players { width: 70dp; text-align: right; }

/* ---- campaign ------------------------------------------------------- */

.hero {
	flex: none;
	position: relative;
	height: 96dp;
	margin-bottom: 12dp;
	border: 1dp #3f3f46;
	background-color: #0c0c0f;
	cursor: pointer;
	tab-index: auto;
	nav: auto;
}
.hero:hover, .hero:focus-visible {
	border-color: #4da6ff;
}
.hero .shade, .level .shade {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	decorator: horizontal-gradient(#000000cc #00000040);
}
.hero .text {
	position: absolute;
	left: 18dp;
	top: 24dp;
	font-size: 24dp;
	font-weight: bold;
}
.hero .sub {
	font-size: 14dp;
	color: #a1a1aa;
	font-weight: normal;
	margin-top: 4dp;
}
.camp-head {
	flex: none;
	display: flex;
	flex-direction: row;
	margin-bottom: 8dp;
}
.camp-head .title {
	flex: 1 1 0;
	text-align: center;
	padding-top: 12dp;
	font-size: 19dp;
}
.camp-head .button {
	flex: none;
	min-width: 56dp;
	margin: 0;
}
.level {
	position: relative;
	display: block;
	height: 116dp;
	border-bottom: 1dp #27272a;
	background-color: #0c0c0f;
	cursor: pointer;
	tab-index: auto;
	nav: auto;
	overflow: hidden;
}
.level.locked {
	opacity: 0.45;
	cursor: default;
}
.level.selected {
	border: 2dp #4da6ff;
}
.level .text {
	position: absolute;
	left: 14dp;
	top: 8dp;
	right: 120dp;
	bottom: 6dp;
	overflow: hidden;
}
.level .num {
	font-size: 13dp;
	color: #4da6ff;
}
.level .name {
	font-size: 20dp;
	font-weight: bold;
	margin-bottom: 3dp;
}
.level .desc {
	font-size: 13dp;
	color: #a1a1aa;
}
.level .badge {
	position: absolute;
	right: 14dp;
	top: 12dp;
	font-size: 13dp;
	padding: 4dp 8dp 2dp 8dp;
	background-color: #2b78c9;
}
.level .badge.done {
	background-color: #207a30;
}
.level.locked .badge {
	background-color: #3f3f46;
}

.only-short {
	display: none;
}

/* ---- phones ---------------------------------------------------------- */

@media (max-height: 500dp) {
	#content {
		left: 2%;
		right: 2%;
		width: auto;
		margin-left: 0;
		top: 2%;
		bottom: 2%;
	}
	#content .dialog-body {
		padding: 8dp 12dp 2dp 12dp;
	}
	#content .dialog-buttons {
		padding: 4dp 12dp 10dp 12dp;
	}
	/* too little height for the banner: instant action moves to the buttons */
	.hero {
		display: none;
	}
	.only-short {
		display: inline-block;
	}
}
@media (orientation: portrait) {
	#content {
		left: 2%;
		right: 2%;
		width: auto;
		margin-left: 0;
		top: 2%;
		bottom: 2%;
	}
	#content .dialog-body {
		padding: 10dp 10dp 2dp 10dp;
	}
	#content .dialog-buttons {
		padding: 4dp 10dp 12dp 10dp;
		text-align: center;
	}
	.srv .cells .c-map, .srv .cells .c-type, .srv-head .c-map, .srv-head .c-type {
		display: none;
	}
	.srv .cells .c-ping, .srv-head .c-ping {
		width: 44dp;
	}
	.bar-row {
		flex-wrap: wrap;
	}
	.bar-row > .grow {
		flex: 1 1 100%;
		margin-right: 0;
		margin-bottom: 8dp;
	}
	#content .dialog-buttons {
		flex-wrap: wrap;
	}
	#content .dialog-buttons > .grow {
		flex: 1 1 100%;
		margin-right: 0;
		margin-bottom: 8dp;
	}
	.dialog-hint {
		display: none;
	}
	#content .dialog-buttons .button {
		min-width: 0;
		padding-left: 16dp;
		padding-right: 16dp;
		margin-left: 6dp;
	}
	.label {
		flex: 1 1 100%;
		padding: 0 0 2dp 0;
		font-size: 13dp;
	}
	.level .text {
		right: 14dp;
	}
	.level .badge {
		display: none;
	}
}

/* ---- server info panel ---------------------------------------------- */

.info-veil {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: #000000b3;
	z-index: 10;
}
.info {
	position: absolute;
	left: 50%;
	width: 620dp;
	margin-left: -310dp;
	top: 6%;
	background-color: #0c0c0f;
	border: 1dp #4da6ff;
	display: flex;
	flex-direction: column;
}
.info .pic {
	flex: none;
	position: relative;
	height: 190dp;
	background-color: #09090b;
}
/* with players the panel is tall and the list scrolls; without it ends
   after the facts */
.info.tall {
	bottom: 6%;
}
.info .none {
	flex: none;
	padding: 14dp 14dp 6dp 14dp;
	color: #71717a;
	font-size: 16dp;
}
.info .pic .nopic {
	position: absolute;
	left: 0;
	right: 0;
	top: 40%;
	text-align: center;
	font-size: 26dp;
	color: #71717a;
}
.info .t {
	flex: none;
	padding: 12dp 14dp 8dp 14dp;
	background-color: #18181b;
	border-bottom: 1dp #4da6ff;
	font-size: 19dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
}
.info .facts {
	flex: none;
	padding: 10dp 14dp 4dp 14dp;
	font-size: 15dp;
	color: #a1a1aa;
}
.info .facts b {
	color: #ffffff;
}
.info .plist {
	flex: 1 1 0;
	min-height: 0;
	margin: 4dp 14dp 0 14dp;
}
.info .plist .item {
	display: flex;
	flex-direction: row;
	cursor: default;
	padding-top: 8dp;
	padding-bottom: 6dp;
}
.info .plist .item > div { flex: none; width: 60dp; }
.info .plist .item > .n { flex: 1 1 0; min-width: 0; overflow: hidden; white-space: nowrap; }
.info .plist .spec { color: #71717a; }
.info .btns .button {
	min-width: 0;
	padding-left: 16dp;
	padding-right: 16dp;
}
.info .btns {
	flex: none;
	padding: 10dp 14dp 12dp 14dp;
	text-align: right;
}
@media (max-height: 500dp) {
	.info {
		width: auto;
		left: 2%;
		right: 2%;
		margin-left: 0;
		top: 2%;
	}
	.info.tall {
		bottom: 2%;
	}
	.info .pic {
		height: 100dp;
	}
	.info .facts {
		padding-top: 6dp;
	}
}
@media (orientation: portrait) {
	.info {
		width: auto;
		left: 2%;
		right: 2%;
		margin-left: 0;
		top: 3%;
	}
	.info.tall {
		bottom: 3%;
	}
}
