#content {
	width: 560dp;
	margin-left: -280dp;
	margin-top: -230dp;
}

/* the same as welcome.rcss: undo the fixed width and margins on small screens */
@media (max-height: 500dp) {
	#content {
		left: 3%;
		right: 3%;
		top: 2%;
		width: auto;
		margin-left: 0;
		margin-top: 0;
	}
}
@media (orientation: portrait) {
	#content {
		left: 3%;
		right: 3%;
		width: auto;
		margin-left: 0;
		margin-top: -200dp;
	}
}
@media (max-width: 640dp) {
	#content {
		left: 3%;
		right: 3%;
		width: auto;
		margin-left: 0;
	}
}
