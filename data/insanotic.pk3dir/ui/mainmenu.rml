<rml>
<head>
	<title>Insanotic main menu</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="mainmenu.rcss"/>
</head>
<body>
	<!-- The three big picture buttons and the two small ones below them, as in
	     the QuakeC menu. A data-cmd is the console command a click runs;
	     "menu_cmd directmenu X" makes the QuakeC menu open its dialog X. -->
	<!-- The Xonotic logo (the 0.8.6 art). The QuakeC menu draws its own copy
	     behind this one only when this document is not used. -->
	<img id="logo" src="logo.png"/>
	<div id="stage">
		<div id="big">
			<div class="card" id="singleplayer" data-cmd="rml_show singleplayer">
				<div class="shade"></div>
				<div class="glow"></div>
				<div class="text">
					<div class="sub">Campaign and instant action against bots</div>
					<div class="title">Singleplayer</div>
				</div>
			</div>
			<div class="card" id="multiplayer" data-cmd="rml_show servers">
				<div class="shade"></div>
				<div class="glow"></div>
				<div class="text">
					<div class="sub">Play online or on your network</div>
					<div class="title">Multiplayer</div>
				</div>
			</div>
			<div class="card" id="settings" data-cmd="rml_show settings">
				<div class="shade"></div>
				<div class="glow"></div>
				<div class="text">
					<div class="sub">Controls, video and audio</div>
					<div class="title">Settings</div>
				</div>
			</div>
		</div>
		<div id="small">
			<div class="chip" data-cmd="rml_show quicksettings"><div class="glow"></div><div class="label">Quick settings</div></div>
			<div class="chip" data-cmd="menu_cmd directmenu Credits"><div class="glow"></div><div class="label">Credits</div></div>
			<div class="chip" data-cmd="rml_show quit"><div class="glow"></div><div class="label">Quit</div></div>
		</div>
	</div>
	<div id="version">Insanotic <span data-cvar="insanotic_version"></span>  |  Xonotic <span data-cvar="g_xonoticversion"></span></div>
</body>
</rml>
