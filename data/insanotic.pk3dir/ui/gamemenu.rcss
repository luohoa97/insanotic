/* The in-game menu. The engine sets "demo", "campaign" and "solo" on the
   body (ui_rml_engine.c); everything that depends on them is here. */

#content {
	width: 440dp;
	margin-left: -220dp;
	margin-top: -210dp;
}
#content .dialog-body {
	padding: 16dp 18dp 8dp 18dp;
}

/* Phones. components.rcss makes dialogs fill the screen, but an id selector
   (#content above) outranks its class selectors, so the fixed width and the
   negative margins kept winning and pushed the menu off the screen. The
   phone rules are repeated here, on the id, and written out twice because
   RmlUi media queries have no "or". A short screen also gets tighter buttons
   and a body that scrolls, so the last button is never cut off. */
@media (max-height: 500dp) {
	#content {
		left: 50%;
		right: auto;
		top: 2%;
		width: 440dp;
		margin-left: -220dp;
		margin-top: 0;
	}
	#content .dialog-body {
		padding: 10dp 14dp 4dp 14dp;
		max-height: 360dp;
		overflow-y: auto;
	}
	#content .button {
		padding-top: 9dp;
		padding-bottom: 7dp;
	}
	#content .button.block, #content .pair {
		margin-bottom: 6dp;
	}
}
@media (orientation: portrait) {
	#content {
		left: 3%;
		right: 3%;
		width: auto;
		margin-left: 0;
		margin-top: -210dp;
	}
}

.pair {
	display: flex;
	flex-direction: row;
	margin-bottom: 10dp;
}
.pair .button {
	flex: 1 1 0;
	min-width: 0;
	margin-left: 10dp;
	padding-left: 8dp;
	padding-right: 8dp;
}
.pair .button:first-child {
	margin-left: 0;
}

/* which words and buttons show */
.only-campaign, .only-demo, .only-solo {
	display: none;
}
.word {
	display: none;
}
.only-online {
	display: inline;
}
body.campaign .only-campaign {
	display: block;
}
body.campaign .not-campaign {
	display: none;
}
body.demo .not-demo {
	display: none;
}

/* the leave button names what is being left; one word shows at a time,
   a later rule beats an earlier one of the same weight */
.leave .word {
	display: none;
}
.leave .only-online {
	display: inline;
}
body.solo .leave .only-online, body.campaign .leave .only-online, body.demo .leave .only-online {
	display: none;
}
body.solo .leave .only-solo {
	display: inline;
}
body.campaign .leave .only-solo {
	display: none;
}
body.campaign .leave .only-campaign {
	display: inline;
}
body.demo .leave .only-solo, body.demo .leave .only-campaign {
	display: none;
}
body.demo .leave .only-demo {
	display: inline;
}
