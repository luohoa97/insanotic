<rml>
<head>
	<title>Touch test</title>
	<link type="text/rcss" href="common.rcss"/>
	<style>
		body { width: 100%; height: 100%; font-size: 16dp; }
		/* 1280x720: the button covers x 512 to 768 and y 288 to 432 */
		#btn { position: absolute; left: 40%; top: 40%; width: 20%; height: 20%; background-color: #20507a; }
		#btn:hover { background-color: #ff0000; }
		#btn:active { background-color: #00ff00; }
	</style>
</head>
<body>
	<!-- A finger that goes down elsewhere and drags over the button must not
	     hover, press or click it; one that goes down on it presses it while
	     it is over it. -->
	<div id="btn" data-cmd="echo TOUCH_CLICKED">button</div>
</body>
</rml>
